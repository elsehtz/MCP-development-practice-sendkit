{
    "name": "sendkit-workspace",
    "private": true,
    "type": "module",
    "version": "0.0.0",
    "main": "index.js",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev:cli" : "bun run packages/cli/src/index.ts",
        "dev:stdio": "bun run packages/stdio-mcp/src/index.ts", 
